# Copy this file to setup/.env and fill it in. It's git-ignored.
# The npm scripts (npm run up, etc.) load it before running Pulumi.

# Tenant domain, without https:// (e.g. dev-xxxx.us.auth0.com)
AUTH0_DOMAIN=

# Credentials of the "pulumi" Machine to Machine app (authorized for the Auth0 Management API).
# The Auth0 provider reads these exact names.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Password for both demo users. Default policy: 8+ characters with lowercase, uppercase and numbers
DEMO_USER_PASSWORD=

# Encrypts the secrets in Pulumi's state (setup/.pulumi/). Pick anything, and keep it: it's needed
# for every later command on this stack.
PULUMI_CONFIG_PASSPHRASE=

# Optional
# AUTH0_AUDIENCE=https://auth0-integration-demo
# AUTH0_CONNECTION_NAME=Username-Password-Authentication
