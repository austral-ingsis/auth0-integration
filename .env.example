# Copy this file to .env and fill it in. .env is git-ignored.
# The service reads it on startup (see spring.config.import in application.yml).
# With the Pulumi setup, get the values with `pulumi stack output` inside setup/.

# Tenant domain, without https:// (e.g. dev-xxxx.us.auth0.com)
AUTH0_DOMAIN=

# Identifier of the Auth0 API (the token's "aud"), e.g. https://auth0-integration-demo
AUTH0_AUDIENCE=

# Client ID of the application, used to get a token with the Auth0 CLI:
#   auth0 test token $AUTH0_APP_CLIENT_ID --audience $AUTH0_AUDIENCE --scopes read:snippets
# (Not AUTH0_CLIENT_ID: Pulumi's Auth0 provider reads that name for its own credentials.)
AUTH0_APP_CLIENT_ID=
